# Copy to config.env and edit. config.env is git-ignored.
# NAS root (mapped drive on Windows e.g. Z:/DrMitRing, or /Volumes/... on Mac)
NAS_ROOT=Z:/DrMitRing
# Where raw footage is dropped on the NAS
NAS_INCOMING=Z:/DrMitRing/incoming
# Where finished ad sets are copied at the end
NAS_DELIVER=Z:/DrMitRing/deliver
# Local fast disk used for rendering (do NOT render over the network)
WORK_ROOT=./batches
# SuamiSihat Design System repo on this machine (source of brand assets and claims rules)
DESIGN_SYSTEM_ROOT=D:/HaNa_Innovation/ssDesignSystem
# This repo / working folder on the studio PC
REPO_ROOT=D:/HaNa_Innovation/ss-dtc
# Royalty-free stock b-roll (scripts/stock_fetch.py). Free keys from pexels.com/api and pixabay.com/api/docs. Never commit real keys.
PEXELS_API_KEY=PASTE_YOUR_PEXELS_KEY
PIXABAY_API_KEY=PASTE_YOUR_PIXABAY_KEY
# Shared b-roll library on the NAS (one folder per source, licence record per clip)
BROLL_LIBRARY=//Ssnas/drm/SS-DTC/broll-library
# Swipe library (scripts/swipe_ingest.py): Telegram swipe-file exports, tagged. Index + media on the NAS, never in git.
SWIPE_LIBRARY=//Ssnas/drm/SS-DTC/swipe-library
# Concept photos (scripts/render_concepts.py): AWS Bedrock. Use a Bedrock API key, OR leave it as is and set AWS_PROFILE (needs pip install boto3). Never commit a real key.
AWS_BEARER_TOKEN_BEDROCK=PASTE_YOUR_BEDROCK_API_KEY
AWS_REGION=us-east-1
# AWS_PROFILE=
# Optional: USD per image for the concept budget check, and model id overrides
# COST_NOVA=
# COST_STABILITY=
# COST_UPSCALE=
# NOVA_MODEL_ID=amazon.nova-canvas-v1:0
