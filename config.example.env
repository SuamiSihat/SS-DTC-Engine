# Copy to config.env and edit. config.env is git-ignored.
# NAS root (mapped drive on Windows e.g. Z:/DrMitRing, or /Volumes/... on Mac)
NAS_ROOT=Z:/DrMitRing
# Where raw footage is dropped on the NAS
NAS_INCOMING=Z:/DrMitRing/incoming
# Where finished ad sets are copied at the end
NAS_DELIVER=Z:/DrMitRing/deliver
# Local fast disk used for rendering (do NOT render over the network)
WORK_ROOT=./batches
# SuamiSihat Design System repo on this machine (source of brand assets and claims rules)
DESIGN_SYSTEM_ROOT=D:/HaNa_Innovation/ssDesignSystem
# This repo / working folder on the studio PC
REPO_ROOT=D:/HaNa_Innovation/ss-dtc
